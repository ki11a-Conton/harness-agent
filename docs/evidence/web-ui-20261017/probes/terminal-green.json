  "code": "await page.getByRole('button',{name:'Choose workspace',exact:true}).click();await page.getByRole('menuitem',{name:'project',exact:true}).click();await page.getByRole('button',{name:'Settings',exact:true}).click();await page.getByRole('button',{name:'Increase font size',exact:true}).waitFor();if(await page.getByRole('button',{name:'Open configuration file',exact:true}).count())throw Error('Unavailable native opener was advertised');await page.getByRole('button',{name:'Close',exact:true}).click();await page.getByRole('button',{name:'Open right sidebar',exact:true}).click();await page.getByRole('button',{name:'New terminal Run commands in the Session workspace',exact:true}).click();await page.getByRole('button',{name:'Reject',exact:true}).waitFor({timeout:10000});await page.getByRole('button',{name:'Reject',exact:true}).click();await page.getByRole('button',{name:'Retry',exact:true}).waitFor({timeout:10000});const rejected=(await page.locator('body').innerText()).slice(-900);await page.getByRole('button',{name:'Retry',exact:true}).click();let approvals=0;for(let i=0;i<4;i++){const allow=page.getByRole('button',{name:'Allow once',exact:true});try{await allow.waitFor({timeout:3000})}catch{break}await allow.click();approvals++;}await page.getByRole('button',{name:'Retry',exact:true}).waitFor({timeout:10000});const text=await page.locator('body').innerText();if(!text.includes('sandbox backend linux-bwrap self-test failed')||text.includes('This terminal no longer exists'))throw Error('Failure reason lost');return {nativeOpenerHidden:true,rejected,approvals,visibleTerminalError:text.slice(-1500),realTerminalExecuted:false};\n",
