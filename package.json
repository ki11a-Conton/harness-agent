{
  "name": "agent-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && vitest run --exclude '**/*.perf.test.ts' --exclude '**/*.soak.test.ts' --exclude '**/e3-repro-current-defects.test.ts' --exclude '**/e4-r40-forensics.test.ts' --exclude '**/r97-driver-closed-loop.test.ts'",
    "test:watch": "vitest",
    "e3:repro-current-defects": "vitest run apps/cli/src/e3-repro-current-defects.test.ts",
    "test:forensics": "vitest run apps/cli/src/e4-r40-forensics.test.ts",
    "test:perf": "vitest run '**/*.perf.test.ts'",
    "test:soak": "vitest run '**/*.soak.test.ts'",
    "test:red-next-gaps": "vitest run --config apps/cli/test-infra/red-next-gaps-vitest.config.ts",
    "test:n0-gaps": "vitest run --config apps/cli/test-infra/n0-gaps-vitest.config.ts",
    "test:r0-gaps": "vitest run --config apps/cli/test-infra/r0-gaps-vitest.config.ts apps/cli/src/r0-f6-ci-readiness-classification.test.ts apps/cli/src/r0-f5-pricing-declaration-gaps.test.ts",
    "test:formal-gate": "vitest run apps/cli/src/r5-formal-gate.test.ts apps/cli/src/dual-platform-acceptance.test.ts apps/cli/src/provider-offline-profile.test.ts",
    "e4:formal-r5": "node scripts/e4/r5-real-formal.mjs",
    "e4:formal-r5:verify": "node scripts/e4/r5-real-formal.mjs --verify .ci/r5-evidence",
    "e4:ci-readiness": "node scripts/e4/ci-readiness.mjs",
    "e4:dual-platform": "node scripts/e4/dual-platform-acceptance.mjs",
    "test:coverage": "tsc -b && vitest run --coverage --exclude '**/*.perf.test.ts' --exclude '**/*.soak.test.ts' --exclude '**/e3-repro-current-defects.test.ts' --exclude '**/e4-r40-forensics.test.ts' --exclude '**/r97-driver-closed-loop.test.ts'",
    "benchmark:smoke": "node apps/cli/dist/main.js benchmark smoke",
    "benchmark:campaign:validate": "node apps/cli/dist/main.js benchmark campaign validate scripts/benchmark/fixtures/r84-campaign/campaign --cases scripts/benchmark/fixtures/r84-campaign/cases --suites adversarial,stress --expect aaaa1111,bbbb2222",
    "benchmark:campaign:fixture-check": "node scripts/benchmark/fixtures/r84-campaign/generate.mjs --check",
    "docs:verify": "node apps/cli/dist/main.js docs:verify",
    "test:protocol": "vitest run packages/gateway/src/transport-conformance.test.ts packages/sdk/src/conformance.test.ts packages/protocol",
    "test:security": "vitest run packages/security packages/harness/src/security-regression-matrix.test.ts",
    "test:race": "vitest run packages/core/src/runtime/race-split.test.ts packages/core/src/runtime/race-part0.test.ts packages/core/src/runtime/race-part1.test.ts packages/core/src/runtime/race-part2.test.ts packages/core/src/runtime/race-part3.test.ts packages/core/src/runtime/race-part4.test.ts packages/core/src/runtime/race-bisect.test.ts packages/core/src/runtime/race-bisect3.test.ts packages/core/src/runtime/race-bisect5.test.ts packages/core/src/runtime/session-race.test.ts packages/core/src/runtime/session-race2.test.ts",
    "test:chaos": "vitest run packages/mcp/src/mcp-chaos.test.ts",
    "capability:audit": "node apps/cli/dist/main.js audit --strict",
    "e4:verify-production-usage": "node apps/cli/dist/main.js usage-audit --strict",
    "release:verify": "node apps/cli/dist/main.js release verify",
    "release:gate": "node apps/cli/dist/main.js release gate",
    "release:artifacts": "node apps/cli/dist/main.js release artifacts",
    "deps:audit": "pnpm audit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
